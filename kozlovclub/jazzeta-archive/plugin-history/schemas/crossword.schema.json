{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kozlovclub.ru/gazeta/schemas/es-crossword-1.0.json",
  "title": "Кроссворд недели «Ежедневного стандарта» (es-crossword-1.0)",
  "description": "Слова и вопросы. Сетку строит плагин. Полные правила — docs/CROSSWORD.md.",
  "type": "object",
  "required": ["format", "title", "words"],
  "properties": {
    "format": { "const": "es-crossword-1.0" },
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "intro": { "type": "string", "maxLength": 300 },
    "author": { "type": "string", "maxLength": 80 },
    "words": {
      "type": "array",
      "minItems": 12,
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": ["answer", "clue"],
        "properties": {
          "answer": {
            "type": "string",
            "description": "Слово или имя как пишется: буквы одного алфавита, пробел и дефис. В сетке без пробелов и дефисов, Ё = Е; 3–21 буква.",
            "pattern": "^[A-Za-zА-Яа-яЁё][A-Za-zА-Яа-яЁё \\-]*[A-Za-zА-Яа-яЁё]$",
            "maxLength": 40
          },
          "clue": { "type": "string", "minLength": 5, "maxLength": 200, "description": "Вопрос без самого ответа." },
          "source": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 500, "description": "Ссылка на источник факта; видна читателям вместе с ответами." },
          "note": { "type": "string", "maxLength": 300, "description": "Заметка для редакции; читатели её не видят." }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
