APP_HOST=127.0.0.1
APP_PORT=8765
DATABASE_PATH=data/competitors_v2.sqlite3
REPORT_DIR=data/reports
TIMEZONE=Europe/Moscow
WEEKLY_DAY=mon
WEEKLY_HOUR=9
WEEKLY_MINUTE=0
HTTP_TIMEOUT=35
REQUEST_DELAY_SECONDS=0.8
MAX_CONCURRENCY=4
USER_AGENT=KozlovClubCompetitorRadar/2.0 (+mailto:art@kozlovclub.ru)
ENABLE_SCHEDULER=true
STRICT_ROBOTS=true

# До четырёх внутренних Google Calendar. В настройках календаря получите секретную ICS-ссылку.
# Ссылки разделяются точкой с запятой.
KOZLOV_ICS_URLS=

# Необязательно: доставка краткого резюме в Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательно: доставка отчёта по email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
