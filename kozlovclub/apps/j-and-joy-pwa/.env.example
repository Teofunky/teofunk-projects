# Copy to .env in the project root before production launch.
PORT=8080
NODE_ENV=production
INVITE_CODE=replace-with-a-long-random-invite-code
SESSION_DAYS=30
PASSWORD_PEPPER=replace-with-a-long-random-server-secret
VAPID_SUBJECT=mailto:admin@your-domain.example
# Optional. If omitted, the server generates and persists a VAPID pair in server/data/vapid.json.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# COOKIE_SECURE=true
