# Концертный барометр: local configuration
# Copy to .env and fill in. Never commit .env.

BAROMETER_ENVIRONMENT=local
BAROMETER_TIMEZONE=Europe/Moscow
BAROMETER_GEOGRAPHY=RU-MOW

# --- database -------------------------------------------------------------
BAROMETER_DATABASE_URL=postgresql+psycopg://barometer:barometer@localhost:5432/barometer
BAROMETER_DB_ECHO=false
# Set true in production, where TimescaleDB is expected to be present.
BAROMETER_REQUIRE_TIMESCALEDB=false

# --- raw snapshot storage -------------------------------------------------
BAROMETER_STORAGE_BACKEND=local
BAROMETER_SNAPSHOT_ROOT=./var/snapshots
# BAROMETER_S3_BUCKET=
# BAROMETER_S3_ENDPOINT_URL=
# BAROMETER_S3_REGION=

# --- ingest ---------------------------------------------------------------
# Identifies us to the sources we read. Put a real contact address here: a
# publisher who can reach you is a publisher who blocks you less often.
BAROMETER_HTTP_CONTACT=
BAROMETER_HTTP_TIMEOUT_SECONDS=30

# --- source credentials ---------------------------------------------------
# Only set these once the corresponding source is cleared in config/sources.yaml.
BAROMETER_YANDEX_WORDSTAT_TOKEN=
BAROMETER_MOSDATA_API_KEY=
BAROMETER_TICKETSCLOUD_TOKEN=

# --- agents ---------------------------------------------------------------
BAROMETER_AGENT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
BAROMETER_ANTHROPIC_MODEL=
# OPENAI_API_KEY=
# BAROMETER_OPENAI_MODEL=
